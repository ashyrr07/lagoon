    <!-- Per-brand keep-alive guides. Menu paths follow the phone's own settings names. -->
    <string name="island_oem_xiaomi_summary">HyperOS and MIUI stop apps that are not on the Autostart list and apply their own battery saver on top of Android\'s.</string>
    <string name="island_oem_xiaomi_autostart_title">Allow autostart</string>
    <string name="island_oem_xiaomi_autostart_detail">Security app &gt; Manage apps &gt; Lagoon &gt; Autostart on.</string>
    <string name="island_oem_xiaomi_battery_title">No battery restrictions</string>
    <string name="island_oem_xiaomi_battery_detail">Settings &gt; Apps &gt; Manage apps &gt; Lagoon &gt; Battery saver &gt; No restrictions.</string>
    <string name="island_oem_xiaomi_lock_title">Lock it in Recents</string>
    <string name="island_oem_xiaomi_lock_detail">Open Recents, pull Lagoon\'s card down until a padlock appears, so a swipe-clear keeps it.</string>

    <string name="island_oem_samsung_summary">One UI puts apps to sleep after a few days without use and may stop the notification listener with them.</string>
    <string name="island_oem_samsung_never_sleeping_title">Never sleeping apps</string>
    <string name="island_oem_samsung_never_sleeping_detail">Settings &gt; Battery &gt; Background usage limits &gt; Never sleeping apps &gt; add Lagoon.</string>
    <string name="island_oem_samsung_adaptive_title">Adaptive battery</string>
    <string name="island_oem_samsung_adaptive_detail">On the same screen turn off \"Put unused apps to sleep\" if the island keeps vanishing.</string>

    <string name="island_oem_huawei_summary">EMUI\'s app launch manager stops everything it does not manage by hand.</string>
    <string name="island_oem_huawei_manual_title">Manage manually</string>
    <string name="island_oem_huawei_manual_detail">Settings &gt; Battery &gt; App launch &gt; Lagoon &gt; Manage manually &gt; allow Auto-launch, Secondary launch and Run in background.</string>
    <string name="island_oem_huawei_protected_title">Protected apps</string>
    <string name="island_oem_huawei_protected_detail">On older EMUI: Phone Manager &gt; Protected apps &gt; Lagoon on.</string>

    <string name="island_oem_oppo_summary">ColorOS and OxygenOS share one battery manager that stops apps unless they may auto-launch.</string>
    <string name="island_oem_oppo_autolaunch_title">Allow auto-launch</string>
    <string name="island_oem_oppo_autolaunch_detail">Settings &gt; Apps &gt; Lagoon &gt; Allow auto-launch (also \"Allow other apps to launch\").</string>
    <string name="island_oem_oppo_battery_title">Battery usage: no limits</string>
    <string name="island_oem_oppo_battery_detail">Settings &gt; Battery &gt; More settings &gt; App battery management &gt; Lagoon &gt; Don\'t optimise, and turn off \"Sleep standby optimisation\".</string>

    <string name="island_oem_vivo_summary">Funtouch and OriginOS need both autostart and high background power consumption allowed.</string>
    <string name="island_oem_vivo_autostart_title">Allow autostart</string>
    <string name="island_oem_vivo_autostart_detail">i Manager &gt; App manager &gt; Autostart manager &gt; Lagoon on.</string>
    <string name="island_oem_vivo_power_title">High background power</string>
    <string name="island_oem_vivo_power_detail">Settings &gt; Battery &gt; Background power consumption management &gt; Lagoon &gt; Allow high background power consumption.</string>

    <string name="island_oem_other_summary">Stock Android keeps notification listeners alive on its own. If the island still disappears, check the app\'s battery setting.</string>
    <string name="island_oem_other_battery_title">Battery: unrestricted</string>
    <string name="island_oem_other_battery_detail">Settings &gt; Apps &gt; Lagoon &gt; Battery &gt; Unrestricted.</string>

