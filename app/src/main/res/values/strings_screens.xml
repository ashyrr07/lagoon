    <!-- Enhanced mode disclosure -->
    <string name="screens_enhanced_title">Enhanced mode</string>
    <string name="screens_enhanced_intro">Optional. Lagoon works fully without it. Enhanced mode uses an accessibility service for one reason: an accessibility window is the only kind Android draws above the status bar and the lock screen.</string>
    <string name="screens_enhanced_unlocks_title">What it unlocks</string>
    <string name="screens_enhanced_unlocks_taps">Taps anywhere on the pill, including the part inside the status bar, so the island can hug the camera and still be tappable.</string>
    <string name="screens_enhanced_unlocks_lock_screen">The island on the lock screen (you can turn this off below).</string>
    <string name="screens_enhanced_unlocks_tiles">Screenshot, lock screen and recent apps tiles in the control deck.</string>
    <string name="screens_enhanced_unlocks_app_detection">Exact detection of the app in front, for per-app hiding and app-aware activities.</string>
    <string name="screens_enhanced_never_title">What it never does</string>
    <string name="screens_enhanced_never_reads">It never reads what is on your screen: the service is declared without access to window content and without the ability to inspect other apps\' windows.</string>
    <string name="screens_enhanced_never_gestures">It never performs gestures or taps for you.</string>
    <string name="screens_enhanced_never_app_name">It only receives the name of the app that came to the front, nothing from inside the app.</string>
    <string name="screens_enhanced_never_data">No data leaves your phone. Lagoon has no internet permission at all.</string>
    <string name="screens_enhanced_warning">Android will warn that the service can \"view and control your screen\". That is the generic accessibility warning; Lagoon\'s service is configured so that it cannot do either.</string>
    <string name="screens_enhanced_open_settings">Open Accessibility settings</string>
    <string name="screens_enhanced_turn_on">Turn on in Accessibility settings</string>
    <string name="screens_enhanced_choose_in_list">In the list, choose \"%1$s\" and switch it on. Come back here to check the status.</string>
    <string name="screens_enhanced_lock_screen">Show on lock screen</string>
    <string name="screens_enhanced_lock_screen_detail">Keep the island visible while the phone is locked. Only possible in Enhanced mode.</string>
    <string name="screens_enhanced_status_connected">On and connected</string>
    <string name="screens_enhanced_status_connected_detail">The island is drawn above the status bar.</string>
    <string name="screens_enhanced_status_waiting">On, waiting to connect</string>
    <string name="screens_enhanced_status_waiting_detail">Switched on in Accessibility settings. If this stays here, toggle it off and on again there.</string>
    <string name="screens_enhanced_status_off">Off</string>
    <string name="screens_enhanced_status_off_detail">The island uses the standard overlay window.</string>
    <string name="screens_enhanced_unavailable_title">Not in this build yet</string>
    <string name="screens_enhanced_unavailable_review">Google Play reviews every app that offers an accessibility service. Enhanced mode will arrive in the Play build once that review is complete.</string>
    <string name="screens_enhanced_unavailable_foss">Want it now? Install the FOSS build from the Lagoon GitHub releases page or from F-Droid. It is the same app, open source, with Enhanced mode included. Uninstall this copy first; the two builds are signed differently and cannot be installed over each other.</string>
    <string name="screens_enhanced_restricted_title">One extra step for this install</string>
    <string name="screens_enhanced_restricted_body">This copy of Lagoon was not installed from an app store, so Android 13 and later hide the switch behind \"Restricted setting\" until you allow it:</string>
    <string name="screens_enhanced_restricted_step1">1. Open Lagoon\'s App info page (button below).</string>
    <string name="screens_enhanced_restricted_step2">2. Tap the ⋮ menu in the top-right corner.</string>
    <string name="screens_enhanced_restricted_step3">3. Choose \"Allow restricted settings\" and confirm.</string>
    <string name="screens_enhanced_restricted_missing">If the menu item is missing, first open Accessibility settings, tap %1$s once (Android shows the restricted-setting notice), then come back and try again.</string>
    <string name="screens_enhanced_open_app_info">Open App info</string>
    <string name="screens_enhanced_consent">I understand what Enhanced mode does and does not do, and I consent to Lagoon using an accessibility service for it.</string>
