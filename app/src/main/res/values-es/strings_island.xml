    <!-- Per-brand keep-alive guides -->
    <string name="island_oem_xiaomi_summary">HyperOS y MIUI detienen las apps que no están en la lista de inicio automático y añaden su propio ahorro de batería al de Android.</string>
    <string name="island_oem_xiaomi_autostart_title">Permitir inicio automático</string>
    <string name="island_oem_xiaomi_autostart_detail">App Seguridad &gt; Administrar aplicaciones &gt; Lagoon &gt; Inicio automático activado.</string>
    <string name="island_oem_xiaomi_battery_title">Sin restricciones de batería</string>
    <string name="island_oem_xiaomi_battery_detail">Ajustes &gt; Aplicaciones &gt; Administrar aplicaciones &gt; Lagoon &gt; Ahorro de batería &gt; Sin restricciones.</string>
    <string name="island_oem_xiaomi_lock_title">Bloquéala en Recientes</string>
    <string name="island_oem_xiaomi_lock_detail">Abre Recientes y arrastra hacia abajo la tarjeta de Lagoon hasta que aparezca un candado; así no se cerrará al limpiar la lista.</string>

    <string name="island_oem_samsung_summary">One UI suspende las apps que no usas desde hace unos días y, con ellas, puede detener el acceso a las notificaciones.</string>
    <string name="island_oem_samsung_never_sleeping_title">Aplicaciones que nunca entran en suspensión</string>
    <string name="island_oem_samsung_never_sleeping_detail">Ajustes &gt; Batería &gt; Límites de uso en segundo plano &gt; Aplicaciones que nunca entran en suspensión &gt; añade Lagoon.</string>
    <string name="island_oem_samsung_adaptive_title">Batería adaptable</string>
    <string name="island_oem_samsung_adaptive_detail">Si la isla sigue desapareciendo, desactiva «Suspender aplicaciones no usadas» en la misma pantalla.</string>

    <string name="island_oem_huawei_summary">El gestor de inicio de aplicaciones de EMUI detiene todo lo que no se gestiona manualmente.</string>
    <string name="island_oem_huawei_manual_title">Gestionar manualmente</string>
    <string name="island_oem_huawei_manual_detail">Ajustes &gt; Batería &gt; Inicio de aplicaciones &gt; Lagoon &gt; Gestionar manualmente &gt; permite Inicio automático, Inicio secundario y Ejecutar en segundo plano.</string>
    <string name="island_oem_huawei_protected_title">Aplicaciones protegidas</string>
    <string name="island_oem_huawei_protected_detail">En versiones antiguas de EMUI: Gestor del teléfono &gt; Aplicaciones protegidas &gt; Lagoon activado.</string>

    <string name="island_oem_oppo_summary">ColorOS y OxygenOS comparten un gestor de batería que detiene las apps que no tienen permitido el inicio automático.</string>
    <string name="island_oem_oppo_autolaunch_title">Permitir inicio automático</string>
    <string name="island_oem_oppo_autolaunch_detail">Ajustes &gt; Aplicaciones &gt; Lagoon &gt; Permitir inicio automático (y también «Permitir que otras apps la inicien»).</string>
    <string name="island_oem_oppo_battery_title">Uso de batería: sin límites</string>
    <string name="island_oem_oppo_battery_detail">Ajustes &gt; Batería &gt; Más ajustes &gt; Gestión de batería de las apps &gt; Lagoon &gt; No optimizar, y desactiva «Optimización del modo de suspensión».</string>

    <string name="island_oem_vivo_summary">Funtouch y OriginOS piden permitir tanto el inicio automático como el alto consumo en segundo plano.</string>
    <string name="island_oem_vivo_autostart_title">Permitir inicio automático</string>
    <string name="island_oem_vivo_autostart_detail">i Manager &gt; Gestor de aplicaciones &gt; Gestor de inicio automático &gt; Lagoon activado.</string>
    <string name="island_oem_vivo_power_title">Alto consumo en segundo plano</string>
    <string name="island_oem_vivo_power_detail">Ajustes &gt; Batería &gt; Gestión del consumo en segundo plano &gt; Lagoon &gt; Permitir alto consumo en segundo plano.</string>

    <string name="island_oem_other_summary">Android puro mantiene activo el acceso a las notificaciones por sí solo. Si la isla aún desaparece, revisa el ajuste de batería de la app.</string>
    <string name="island_oem_other_battery_title">Batería: sin restricciones</string>
    <string name="island_oem_other_battery_detail">Ajustes &gt; Aplicaciones &gt; Lagoon &gt; Batería &gt; Sin restricciones.</string>

