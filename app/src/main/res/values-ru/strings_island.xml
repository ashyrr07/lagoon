    <!-- Per-brand keep-alive guides -->
    <string name="island_oem_xiaomi_summary">HyperOS и MIUI останавливают приложения, которых нет в списке автозапуска, и вдобавок к Android включают собственную экономию заряда.</string>
    <string name="island_oem_xiaomi_autostart_title">Разрешите автозапуск</string>
    <string name="island_oem_xiaomi_autostart_detail">Приложение «Безопасность» &gt; Приложения &gt; Lagoon &gt; включите «Автозапуск».</string>
    <string name="island_oem_xiaomi_battery_title">Без ограничений для батареи</string>
    <string name="island_oem_xiaomi_battery_detail">Настройки &gt; Приложения &gt; Все приложения &gt; Lagoon &gt; Контроль активности &gt; Нет ограничений.</string>
    <string name="island_oem_xiaomi_lock_title">Закрепите в недавних</string>
    <string name="island_oem_xiaomi_lock_detail">Откройте недавние приложения и потяните карточку Lagoon вниз, пока не появится замок: тогда очистка списка её не закроет.</string>

    <string name="island_oem_samsung_summary">One UI переводит в спящий режим приложения, которыми не пользовались несколько дней, и вместе с ними может отключить доступ к уведомлениям.</string>
    <string name="island_oem_samsung_never_sleeping_title">Приложения, которые никогда не переходят в спящий режим</string>
    <string name="island_oem_samsung_never_sleeping_detail">Настройки &gt; Батарея &gt; Ограничения фонового использования &gt; Приложения, которые никогда не переходят в спящий режим &gt; добавьте Lagoon.</string>
    <string name="island_oem_samsung_adaptive_title">Адаптивная батарея</string>
    <string name="island_oem_samsung_adaptive_detail">Если остров продолжает пропадать, на том же экране выключите «Переводить неиспользуемые приложения в спящий режим».</string>

    <string name="island_oem_huawei_summary">Диспетчер запуска приложений в EMUI останавливает всё, чем не управляют вручную.</string>
    <string name="island_oem_huawei_manual_title">Управлять вручную</string>
    <string name="island_oem_huawei_manual_detail">Настройки &gt; Батарея &gt; Запуск приложений &gt; Lagoon &gt; Управлять вручную &gt; разрешите автозапуск, косвенный запуск и работу в фоновом режиме.</string>
    <string name="island_oem_huawei_protected_title">Защищённые приложения</string>
    <string name="island_oem_huawei_protected_detail">В старых версиях EMUI: Диспетчер телефона &gt; Защищённые приложения &gt; включите Lagoon.</string>

    <string name="island_oem_oppo_summary">В ColorOS и OxygenOS общий диспетчер батареи, который останавливает приложения без разрешения на автозапуск.</string>
    <string name="island_oem_oppo_autolaunch_title">Разрешите автозапуск</string>
    <string name="island_oem_oppo_autolaunch_detail">Настройки &gt; Приложения &gt; Lagoon &gt; Разрешить автозапуск (а также «Разрешить запуск другими приложениями»).</string>
    <string name="island_oem_oppo_battery_title">Батарея: без ограничений</string>
    <string name="island_oem_oppo_battery_detail">Настройки &gt; Батарея &gt; Другие настройки &gt; Управление батареей приложений &gt; Lagoon &gt; Не оптимизировать, а также выключите «Оптимизацию в режиме сна».</string>

    <string name="island_oem_vivo_summary">Funtouch и OriginOS требуют разрешить и автозапуск, и высокое энергопотребление в фоне.</string>
    <string name="island_oem_vivo_autostart_title">Разрешите автозапуск</string>
    <string name="island_oem_vivo_autostart_detail">i Manager &gt; Диспетчер приложений &gt; Автозапуск &gt; включите Lagoon.</string>
    <string name="island_oem_vivo_power_title">Энергопотребление в фоне</string>
    <string name="island_oem_vivo_power_detail">Настройки &gt; Батарея &gt; Управление энергопотреблением в фоне &gt; Lagoon &gt; Разрешить высокое энергопотребление в фоне.</string>

    <string name="island_oem_other_summary">Обычный Android сам поддерживает доступ к уведомлениям. Если остров всё равно пропадает, проверьте настройку батареи для приложения.</string>
    <string name="island_oem_other_battery_title">Батарея: без ограничений</string>
    <string name="island_oem_other_battery_detail">Настройки &gt; Приложения &gt; Lagoon &gt; Батарея &gt; Без ограничений.</string>

