    <!-- Per-brand keep-alive guides -->
    <string name="island_oem_xiaomi_summary">HyperOS und MIUI beenden Apps, die nicht auf der Autostart-Liste stehen, und legen ihren eigenen Energiesparmodus über den von Android.</string>
    <string name="island_oem_xiaomi_autostart_title">Autostart erlauben</string>
    <string name="island_oem_xiaomi_autostart_detail">Sicherheit-App &gt; Apps verwalten &gt; Lagoon &gt; Autostart an.</string>
    <string name="island_oem_xiaomi_battery_title">Keine Akku-Einschränkungen</string>
    <string name="island_oem_xiaomi_battery_detail">Einstellungen &gt; Apps &gt; Apps verwalten &gt; Lagoon &gt; Energiesparmodus &gt; Keine Einschränkungen.</string>
    <string name="island_oem_xiaomi_lock_title">In den letzten Apps sperren</string>
    <string name="island_oem_xiaomi_lock_detail">Öffne die letzten Apps und zieh die Karte von Lagoon nach unten, bis ein Schloss erscheint. Dann bleibt sie beim Leeren der Liste erhalten.</string>

    <string name="island_oem_samsung_summary">One UI versetzt Apps nach ein paar Tagen ohne Nutzung in den Standby-Modus und kann dabei auch den Benachrichtigungszugriff beenden.</string>
    <string name="island_oem_samsung_never_sleeping_title">Apps, die nie in den Standby-Modus wechseln</string>
    <string name="island_oem_samsung_never_sleeping_detail">Einstellungen &gt; Akku &gt; Hintergrundnutzungslimits &gt; Apps, die nie in den Standby-Modus wechseln &gt; Lagoon hinzufügen.</string>
    <string name="island_oem_samsung_adaptive_title">Adaptiver Akku</string>
    <string name="island_oem_samsung_adaptive_detail">Falls die Insel immer wieder verschwindet, schalte auf demselben Bildschirm „Nicht verwendete Apps in Standby versetzen“ aus.</string>

    <string name="island_oem_huawei_summary">Die App-Startverwaltung von EMUI beendet alles, was nicht manuell verwaltet wird.</string>
    <string name="island_oem_huawei_manual_title">Manuell verwalten</string>
    <string name="island_oem_huawei_manual_detail">Einstellungen &gt; Akku &gt; App-Start &gt; Lagoon &gt; Manuell verwalten &gt; Automatischen Start, Sekundären Start und Im Hintergrund ausführen erlauben.</string>
    <string name="island_oem_huawei_protected_title">Geschützte Apps</string>
    <string name="island_oem_huawei_protected_detail">Bei älterem EMUI: Telefonmanager &gt; Geschützte Apps &gt; Lagoon an.</string>

    <string name="island_oem_oppo_summary">ColorOS und OxygenOS teilen sich eine Akkuverwaltung, die Apps beendet, wenn sie nicht automatisch starten dürfen.</string>
    <string name="island_oem_oppo_autolaunch_title">Automatischen Start erlauben</string>
    <string name="island_oem_oppo_autolaunch_detail">Einstellungen &gt; Apps &gt; Lagoon &gt; Automatischen Start erlauben (auch „Start durch andere Apps erlauben“).</string>
    <string name="island_oem_oppo_battery_title">Akkunutzung: keine Limits</string>
    <string name="island_oem_oppo_battery_detail">Einstellungen &gt; Akku &gt; Weitere Einstellungen &gt; App-Akkuverwaltung &gt; Lagoon &gt; Nicht optimieren, und „Optimierung im Ruhemodus“ ausschalten.</string>

    <string name="island_oem_vivo_summary">Funtouch und OriginOS verlangen, dass sowohl Autostart als auch hoher Energieverbrauch im Hintergrund erlaubt sind.</string>
    <string name="island_oem_vivo_autostart_title">Autostart erlauben</string>
    <string name="island_oem_vivo_autostart_detail">i Manager &gt; App-Manager &gt; Autostart-Manager &gt; Lagoon an.</string>
    <string name="island_oem_vivo_power_title">Hoher Hintergrundverbrauch</string>
    <string name="island_oem_vivo_power_detail">Einstellungen &gt; Akku &gt; Energieverbrauch im Hintergrund verwalten &gt; Lagoon &gt; Hohen Energieverbrauch im Hintergrund erlauben.</string>

    <string name="island_oem_other_summary">Standard-Android hält den Benachrichtigungszugriff von selbst am Laufen. Falls die Insel trotzdem verschwindet, prüf die Akku-Einstellung der App.</string>
    <string name="island_oem_other_battery_title">Akku: uneingeschränkt</string>
    <string name="island_oem_other_battery_detail">Einstellungen &gt; Apps &gt; Lagoon &gt; Akku &gt; Uneingeschränkt.</string>

