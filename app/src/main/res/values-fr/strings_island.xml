    <!-- Per-brand keep-alive guides -->
    <string name="island_oem_xiaomi_summary">HyperOS et MIUI arrêtent les applis absentes de la liste de démarrage automatique et ajoutent leur propre économiseur de batterie à celui d\'Android.</string>
    <string name="island_oem_xiaomi_autostart_title">Autoriser le démarrage auto</string>
    <string name="island_oem_xiaomi_autostart_detail">Appli Sécurité &gt; Gérer les applis &gt; Lagoon &gt; Démarrage automatique activé.</string>
    <string name="island_oem_xiaomi_battery_title">Aucune restriction de batterie</string>
    <string name="island_oem_xiaomi_battery_detail">Paramètres &gt; Applis &gt; Gérer les applis &gt; Lagoon &gt; Économiseur de batterie &gt; Aucune restriction.</string>
    <string name="island_oem_xiaomi_lock_title">Verrouiller dans les récents</string>
    <string name="island_oem_xiaomi_lock_detail">Ouvrez les applis récentes et tirez la carte de Lagoon vers le bas jusqu\'à voir un cadenas : elle restera ouverte quand vous videz la liste.</string>

    <string name="island_oem_samsung_summary">One UI met en veille les applis inutilisées depuis quelques jours et peut couper l\'accès aux notifications avec elles.</string>
    <string name="island_oem_samsung_never_sleeping_title">Applis jamais mises en veille</string>
    <string name="island_oem_samsung_never_sleeping_detail">Paramètres &gt; Batterie &gt; Limites d\'utilisation en arrière-plan &gt; Applis jamais mises en veille &gt; ajoutez Lagoon.</string>
    <string name="island_oem_samsung_adaptive_title">Batterie adaptative</string>
    <string name="island_oem_samsung_adaptive_detail">Si l\'île disparaît encore, désactivez « Mettre en veille les applis inutilisées » sur le même écran.</string>

    <string name="island_oem_huawei_summary">Le gestionnaire de lancement d\'EMUI arrête tout ce qui n\'est pas géré manuellement.</string>
    <string name="island_oem_huawei_manual_title">Gérer manuellement</string>
    <string name="island_oem_huawei_manual_detail">Paramètres &gt; Batterie &gt; Lancement d\'applications &gt; Lagoon &gt; Gérer manuellement &gt; autorisez Lancement auto, Lancement secondaire et Exécution en arrière-plan.</string>
    <string name="island_oem_huawei_protected_title">Applis protégées</string>
    <string name="island_oem_huawei_protected_detail">Sur les anciennes versions d\'EMUI : Gestionnaire du téléphone &gt; Applis protégées &gt; Lagoon activé.</string>

    <string name="island_oem_oppo_summary">ColorOS et OxygenOS partagent un gestionnaire de batterie qui arrête les applis non autorisées à se lancer automatiquement.</string>
    <string name="island_oem_oppo_autolaunch_title">Autoriser le lancement auto</string>
    <string name="island_oem_oppo_autolaunch_detail">Paramètres &gt; Applis &gt; Lagoon &gt; Autoriser le lancement automatique (ainsi que « Autoriser le lancement par d\'autres applis »).</string>
    <string name="island_oem_oppo_battery_title">Batterie : sans limite</string>
    <string name="island_oem_oppo_battery_detail">Paramètres &gt; Batterie &gt; Plus de paramètres &gt; Gestion de la batterie des applis &gt; Lagoon &gt; Ne pas optimiser, puis désactivez « Optimisation de la veille ».</string>

    <string name="island_oem_vivo_summary">Funtouch et OriginOS exigent d\'autoriser à la fois le démarrage auto et une forte consommation en arrière-plan.</string>
    <string name="island_oem_vivo_autostart_title">Autoriser le démarrage auto</string>
    <string name="island_oem_vivo_autostart_detail">i Manager &gt; Gestionnaire d\'applis &gt; Gestionnaire de démarrage auto &gt; Lagoon activé.</string>
    <string name="island_oem_vivo_power_title">Consommation en arrière-plan</string>
    <string name="island_oem_vivo_power_detail">Paramètres &gt; Batterie &gt; Gestion de la consommation en arrière-plan &gt; Lagoon &gt; Autoriser une forte consommation en arrière-plan.</string>

    <string name="island_oem_other_summary">Android d\'origine maintient seul l\'accès aux notifications. Si l\'île disparaît malgré tout, vérifiez le réglage de batterie de l\'appli.</string>
    <string name="island_oem_other_battery_title">Batterie : sans restriction</string>
    <string name="island_oem_other_battery_detail">Paramètres &gt; Applis &gt; Lagoon &gt; Batterie &gt; Sans restriction.</string>

